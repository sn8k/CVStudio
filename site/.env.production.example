DATABASE_URL="file:/app/data/cv.db"
BETTER_AUTH_URL="https://cv.example.com"
PUBLIC_SITE_URL="https://cv.example.com"
BETTER_AUTH_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"
ADMIN_EMAIL="CHANGE_ME_ADMIN_EMAIL"
ADMIN_PASSWORD="CHANGE_ME_WITH_A_LONG_UNIQUE_PASSWORD"
APP_BIND="0.0.0.0"
APP_PORT="3000"
SETTINGS_ENCRYPTION_KEY="CHANGE_ME_WITH_OPENSSL_RAND_BASE64_32"
AUDIENCE_MEASUREMENT_ENABLED="true"
UPDATE_SERVICE_TOKEN="CHANGE_ME_WITH_OPENSSL_RAND_HEX_32"
CVSTUDIO_GIT_REMOTE="https://github.com/sn8k/CVStudio.git"

# Contact SMTP
CONTACT_FORM_ENABLED="false"
CONTACT_SMTP_HOST="smtp.example.com"
CONTACT_SMTP_PORT="587"
CONTACT_SMTP_SECURE="false"
CONTACT_SMTP_USER="CHANGE_ME"
CONTACT_SMTP_PASSWORD="CHANGE_ME"
CONTACT_FROM_EMAIL="cv@example.com"
CONTACT_FROM_NAME="CVStudio"
CONTACT_TO_EMAIL="recipient@example.com"

# Cloudflare Turnstile — utiliser les vraies clés du widget de production
TURNSTILE_SITE_KEY="CHANGE_ME"
TURNSTILE_SECRET_KEY="CHANGE_ME"
