DATABASE_URL="file:./dev.db"
BETTER_AUTH_URL="http://localhost:3000"
PUBLIC_SITE_URL="http://localhost:3000"
BETTER_AUTH_SECRET="generate-a-random-secret-with-at-least-32-characters"
ADMIN_EMAIL="admin@example.local"
ADMIN_PASSWORD="choose-a-long-unique-local-password"
APP_BIND="0.0.0.0"
APP_PORT="3000"

# Clé de développement uniquement — base64 de 32 octets, ne jamais réutiliser en production
SETTINGS_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# Formulaire de contact local — transport JSON, aucun e-mail réel
CONTACT_FORM_ENABLED="true"
CONTACT_SMTP_HOST="smtp.example.test"
CONTACT_SMTP_PORT="587"
CONTACT_SMTP_SECURE="false"
CONTACT_FROM_EMAIL="cv@example.test"
CONTACT_FROM_NAME="CVStudio"
CONTACT_TO_EMAIL="recipient@example.test"
CONTACT_MAIL_TEST_MODE="1"

# Clés officielles Cloudflare Turnstile réservées au développement et aux tests
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
